{
  "$id": "simplicio.context-graph/v1",
  "title": "simplicio-mapper ContextGraph (v1)",
  "description": "Multi-scale, content-addressed graph referenced by a simplicio.context-snapshot/v1 envelope. Nodes are addressed by scale (micro/meso/macro) + logical id; each node/edge carries a content_hash and a reversible source handle so any summary can be expanded back to the originating mapper artifact. Produced by simplicio_mapper.context_snapshot.build_context_graph.",
  "type": "object",
  "required": ["schema", "version", "nodes", "edges"],
  "properties": {
    "schema": { "type": "string", "enum": ["simplicio.context-graph/v1"] },
    "version": { "type": "integer", "enum": [1] },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scale", "content_hash", "source"],
        "properties": {
          "id": { "type": "string" },
          "scale": { "type": "string", "enum": ["micro", "meso", "macro"] },
          "content_hash": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["file"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "span": { "type": "array", "items": { "type": "integer" }, "minItems": 2 }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "source", "target", "content_hash", "source_handle"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "content_hash": { "type": "string" },
          "confidence": { "type": "number" },
          "source_handle": {
            "type": "object",
            "required": ["file"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "span": { "type": "array", "items": { "type": "integer" }, "minItems": 2 }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "integer" },
        "edges": { "type": "integer" },
        "micro": { "type": "integer" },
        "meso": { "type": "integer" },
        "macro": { "type": "integer" }
      }
    }
  }
}
