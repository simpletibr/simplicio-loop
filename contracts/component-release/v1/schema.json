{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/schemas/component-release/v1",
  "title": "SimplicioComponentRelease",
  "type": "object",
  "required": [
    "schema",
    "component",
    "version",
    "commit_sha",
    "commit_sha_source",
    "generated_at",
    "distribution",
    "schema_versions",
    "protocols",
    "capabilities",
    "compatibility",
    "artifact_digest",
    "artifact_digests",
    "signing",
    "downstream_events"
  ],
  "properties": {
    "schema": { "const": "simplicio.component-release/v1" },
    "component": { "const": "simplicio-mapper" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "commit_sha": { "type": ["string", "null"] },
    "commit_sha_source": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "distribution": {
      "type": "object",
      "required": ["pypi_package", "npm_package"],
      "properties": {
        "pypi_package": { "const": "simplicio-mapper" },
        "npm_package": { "const": "@wesleysimplicio/llm-project-mapper" }
      },
      "additionalProperties": false
    },
    "schema_versions": { "type": "object", "additionalProperties": { "type": ["string", "integer"] } },
    "protocols": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "compatibility": { "type": "object" },
    "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact_digests": { "type": "object" },
    "signing": {
      "type": "object",
      "required": ["status", "digest", "signature", "sbom", "note"],
      "properties": {
        "status": { "type": "string" },
        "digest": { "type": ["string", "null"] },
        "signature": { "type": ["string", "null"] },
        "sbom": { "type": ["string", "null"] },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "downstream_events": {
      "type": "object",
      "required": ["status", "note"],
      "properties": {
        "status": { "type": "string" },
        "transport": { "type": "string" },
        "event_type": { "type": "string" },
        "consumers": { "type": "array", "items": { "type": "string" } },
        "deduplication": { "type": "string" },
        "authentication_secret": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
