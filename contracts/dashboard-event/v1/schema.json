{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/dashboard-event/v1/schema.json",
  "title": "simplicio.dashboard-event/v1",
  "description": "One append-only dashboard telemetry event. Loop (coding) kinds are bare catalog names; any other product uses its own '<namespace>.<kind>' namespace with the same envelope.",
  "type": "object",
  "required": [
    "schema", "event_id", "seq", "ts", "run_id", "task_id", "scope", "source", "kind",
    "phase", "lane", "iteration", "severity", "payload", "refs", "producer_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "simplicio.dashboard-event/v1"},
    "event_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "seq": {"type": "integer", "minimum": 1},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "task_id": {"type": ["string", "null"], "minLength": 1},
    "scope": {"enum": ["collection", "task", "scenario"]},
    "source": {"enum": ["hook", "runner", "worker", "oracle", "operator"]},
    "kind": {
      "anyOf": [
        {"enum": [
          "run_started", "phase_entered", "phase_exited", "contract_frozen", "map_ready", "plan_frozen",
          "worker_claimed", "lane_progress", "iteration_started", "iteration_finished", "apply_result",
          "test_result", "lint_result", "coverage_result", "gate_evaluated",
          "command_started", "command_finished",
          "retry_scheduled", "stall_detected", "decision_requested",
          "delivery_reconciled", "pr_opened", "token_usage", "cost_sample",
          "run_finished"
        ]},
        {"type": "string", "pattern": "^(?!loop\\.)[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$"}
      ]
    },
    "phase": {"type": ["string", "null"], "minLength": 1},
    "lane": {"type": ["string", "null"], "minLength": 1},
    "iteration": {"type": ["integer", "null"], "minimum": 0},
    "severity": {"enum": ["debug", "info", "warning", "error"]},
    "payload": {"type": "object"},
    "refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "producer_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]+@[^\\s]+$"},
    "derived": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"scope": {"const": "collection"}}}, "then": {"properties": {"task_id": {"type": "null"}}}},
    {"if": {"properties": {"scope": {"enum": ["task", "scenario"]}}}, "then": {"properties": {"task_id": {"type": "string", "minLength": 1}}}}
  ]
}
