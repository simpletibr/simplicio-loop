{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simplicio.context-graph-contract/v1",
  "title": "Simplicio public ContextGraph contract (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "repository_id", "generation", "stable_ids", "nodes", "relations", "digest"],
  "properties": {
    "schema": {"const": "simplicio.context-graph-contract/v1"},
    "version": {"const": 1},
    "repository_id": {"type": "string", "minLength": 1},
    "generation": {"type": "string", "minLength": 1},
    "stable_ids": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges"], "properties": {"nodes": {"type": "array", "items": {"type": "string"}}, "edges": {"type": "array", "items": {"type": "string"}}}},
    "nodes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "scale"], "properties": {"id": {"type": "string"}, "scale": {"type": "string"}}}},
    "relations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "source", "target"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "source": {"type": "string"}, "target": {"type": "string"}}}},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
