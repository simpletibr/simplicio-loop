{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published simplicio.loop-execution/v1 receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema", "contract_version", "origin", "run_id", "workspace", "run_dir",
    "chain", "fallback_used", "fallback_declared", "artifacts", "mapper", "dev_cli",
    "result"
  ],
  "properties": {
    "schema": {"const": "simplicio.loop-execution/v1"},
    "contract_version": {"const": "v1"},
    "origin": {
      "type": "object",
      "required": ["component", "version", "commit"],
      "properties": {
        "component": {"const": "simplicio-loop"},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1}
      }
    },
    "run_id": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "run_dir": {"type": "string", "minLength": 1},
    "chain": {
      "const": ["simplicio-loop", "simplicio-mapper", "simplicio-dev-cli"]
    },
    "fallback_used": {"const": false},
    "fallback_declared": {"const": false},
    "artifacts": {"type": "object", "minProperties": 5},
    "mapper": {"$ref": "#/$defs/component"},
    "dev_cli": {"$ref": "#/$defs/component"},
    "result": {
      "type": "object",
      "required": ["run_id", "status", "verified"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["COMPLETE", "VERIFIED", "PASSED"]},
        "verified": {"const": true}
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["version", "origin", "fallback"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "minLength": 1},
        "fallback": {"const": false},
        "receipt": {"type": "string", "minLength": 1}
      }
    }
  }
}
