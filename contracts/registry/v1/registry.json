{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/registry/v1/registry.json",
  "registry": "simplicio.contract-registry/v1",
  "version": "1.0.0",
  "compatibility": {
    "policy": "same-major-additive",
    "backward": "A consumer at vN accepts producer payloads with the same major and an older or newer minor/patch version when required fields remain present.",
    "forward": "An older consumer may inspect a newer same-major payload and ignore additive fields; it must reject removed/renamed required fields.",
    "breaking_change": "A removed/renamed required field, changed type, changed hash semantics, or ownership transfer requires a new major schema version."
  },
  "contracts": {
    "context_snapshot": {
      "schema_id": "simplicio.context-snapshot/v1",
      "version": "1.0.0",
      "owner": "simplicio-mapper",
      "producers": ["simplicio-mapper"],
      "consumers": ["simplicio-dev-cli", "simplicio-loop"],
      "schema_path": "schemas/context-snapshot.schema.json"
    },
    "context_delta": {
      "schema_id": "simplicio.context-delta/v1",
      "version": "1.0.0",
      "owner": "simplicio-mapper",
      "producers": ["simplicio-mapper"],
      "consumers": ["simplicio-dev-cli", "simplicio-loop"],
      "schema_path": "schemas/context-delta.schema.json"
    },
    "capability_request": {
      "schema_id": "simplicio.capability-request/v1",
      "version": "1.0.0",
      "owner": "simplicio-loop",
      "producers": ["simplicio-loop", "simplicio-dev-cli"],
      "consumers": ["simplicio-runtime", "simplicio-loop"],
      "schema_path": "schemas/capability-request.schema.json"
    },
    "change_set": {
      "schema_id": "simplicio.change-set/v1",
      "version": "1.0.0",
      "owner": "simplicio-dev-cli",
      "producers": ["simplicio-dev-cli"],
      "consumers": ["simplicio-loop", "simplicio-runtime"],
      "schema_path": "schemas/change-set.schema.json"
    },
    "verification_plan": {
      "schema_id": "simplicio.verification-plan/v1",
      "version": "1.0.0",
      "owner": "simplicio-loop",
      "producers": ["simplicio-loop", "simplicio-dev-cli"],
      "consumers": ["simplicio-loop", "simplicio-runtime"],
      "schema_path": "schemas/verification-plan.schema.json"
    },
    "effect_receipt": {
      "schema_id": "simplicio.effect-receipt/v1",
      "version": "1.0.0",
      "owner": "simplicio-runtime",
      "producers": ["simplicio-runtime", "simplicio-dev-cli"],
      "consumers": ["simplicio-loop", "simplicio-dev-cli"],
      "schema_path": "schemas/effect-receipt.schema.json"
    },
    "stage_receipt": {
      "schema_id": "simplicio.stage-receipt/v1",
      "version": "1.0.0",
      "owner": "simplicio-loop",
      "producers": ["simplicio-loop"],
      "consumers": ["simplicio-runtime", "simplicio-dev-cli"],
      "schema_path": "schemas/stage-receipt.schema.json"
    },
    "run_journal": {
      "schema_id": "simplicio.run-journal/v1",
      "version": "1.0.0",
      "owner": "simplicio-loop",
      "producers": ["simplicio-loop"],
      "consumers": ["simplicio-runtime", "simplicio-dev-cli", "simplicio-mapper"],
      "schema_path": "schemas/run-journal.schema.json"
    }
  }
}
