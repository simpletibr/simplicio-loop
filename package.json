{
  "name": "@wesleysimplicio/llm-project-mapper",
  "version": "0.26.24",
  "description": "AI-friendly project scaffold with AGENTS.md ecosystem (Claude Code, Codex, Copilot, Cursor, Aider, Simplicio Agent, OpenClaw). Specs as code, atomic tasks, automated Definition of Done, reusable skills, multi-agent ready. Canonical consumer/integrator of the produced ContextSnapshot is Simplicio Agent.",
  "type": "commonjs",
  "bin": {
    "llm-project-mapper": "bin/cli.js",
    "build-hamt-catalog": "bin/build-hamt-catalog",
    "apply-edits": "bin/apply-edits.js",
    "skillopt": "bin/skillopt.js"
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "SIMPLICIO_INTEGRATION.md",
    "template-manifest.json",
    "bin/",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "llms.txt",
    "INIT.md",
    "INIT.en.md",
    "_BOOTSTRAP.md",
    "YOOL_TUPLE_HAMT.md",
    "README.md",
    "README.pt-BR.md",
    "READMEs/",
    "INSTALL.md",
    "INSTALL.en.md",
    "docs/",
    "scripts/",
    ".agents/",
    ".claude/",
    ".codex/",
    ".github/",
    ".skills/",
    ".specs/",
    "bootstrap.sh",
    "bootstrap.ps1",
    "playwright.config.ts",
    "tests/",
    "!**/__pycache__/",
    "!**/*.pyc"
  ],
  "engines": {
    "node": ">=16.7.0"
  },
  "keywords": [
    "llm-project-mapper",
    "ai-agent",
    "agents",
    "agents-md",
    "claude-code",
    "codex",
    "copilot",
    "cursor",
    "aider",
    "openclaw",
    "simplicio-agent",
    "hermes",
    "scaffold",
    "starter",
    "bootstrap",
    "specs",
    "playwright",
    "ralph-loop",
    "tdd",
    "ddd"
  ],
  "author": {
    "name": "Wesley Simplicio",
    "email": "wesleybob4@gmail.com",
    "url": "https://github.com/wesleysimplicio"
  },
  "license": "MIT",
  "homepage": "https://github.com/wesleysimplicio/simplicio-mapper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wesleysimplicio/simplicio-mapper.git"
  },
  "bugs": {
    "url": "https://github.com/wesleysimplicio/simplicio-mapper/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:coverage": "node scripts/coverage.js",
    "test:cli": "node bin/cli.js --help",
    "test:e2e": "playwright test",
    "lint": "node scripts/lint.js",
    "lint:fix": "node scripts/lint.js --fix",
    "docs:sync": "node scripts/sync-docs-site.mjs",
    "docs:build": "npm --prefix docs-site run build",
    "docs:start": "npm --prefix docs-site run start",
    "docs:version": "npm --prefix docs-site run docs:version --",
    "evidence": "playwright test --project=chromium",
    "pack:dry": "npm pack --dry-run",
    "quality:fastest-path": "npm run quality:release && python3 scripts/mapper_release_manifest.py --output artifacts/mapper-release-manifest.json",
    "quality:release": "python3 scripts/mapper_quality_gate.py --release --full --require-tools --require-runtime --evidence artifacts/release-evidence.toml",
    "prepublishOnly": "npm run quality:release",
    "release": "npm publish --access public"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
