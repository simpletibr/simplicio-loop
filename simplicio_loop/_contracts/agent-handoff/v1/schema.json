{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/agent-handoff/v1/schema.json",
  "title": "simplicio.agent-handoff/v1",
  "description": "Checkpoint a loop agent writes when its next request would pass the input-token ceiling. A fresh agent of the same family and role continues from it. Rules the schema cannot state (relative paths, total size, MEASURED total) are enforced by simplicio_loop.agent_handoff.validate_handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "task_id", "continuation", "reason", "agent", "objective", "acceptance_criteria",
    "done", "next_steps", "open_questions", "tokens", "lease", "created_at"
  ],
  "properties": {
    "schema": {"const": "simplicio.agent-handoff/v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$", "not": {"enum": [".", ".."]}},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "continuation": {"type": "integer", "minimum": 1, "maximum": 1000},
    "reason": {"enum": ["input_ceiling", "host_signal", "manual"]},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "role", "model"],
      "properties": {
        "family": {"type": "string", "minLength": 1, "maxLength": 64},
        "role": {"enum": ["planning", "coordination", "execution"]},
        "model": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "acceptance_criteria": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "done": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "commands"],
      "properties": {
        "files": {
          "type": "array", "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 512},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "commands": {
          "type": "array", "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exit_code", "summary"],
            "properties": {
              "command": {"type": "string", "minLength": 1, "maxLength": 1000},
              "exit_code": {"type": "integer"},
              "summary": {"type": "string", "maxLength": 1000}
            }
          }
        }
      }
    },
    "next_steps": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "open_questions": {
      "type": "array", "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis", "estimator", "prompt_tokens", "input_tokens", "cache_read_input_tokens",
        "cache_creation_input_tokens", "output_tokens", "ceiling", "cumulative_prompt_tokens"
      ],
      "properties": {
        "basis": {"enum": ["MEASURED", "ESTIMATED"]},
        "estimator": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_read_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_creation_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "ceiling": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "cumulative_prompt_tokens": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"basis": {"const": "MEASURED"}}, "required": ["basis"]},
          "then": {
            "properties": {
              "estimator": {"type": "null"},
              "input_tokens": {"type": "integer"},
              "cache_read_input_tokens": {"type": "integer"},
              "cache_creation_input_tokens": {"type": "integer"}
            }
          }
        },
        {
          "if": {"properties": {"basis": {"const": "ESTIMATED"}}, "required": ["basis"]},
          "then": {
            "properties": {
              "estimator": {"type": "string"},
              "input_tokens": {"type": "null"},
              "cache_read_input_tokens": {"type": "null"},
              "cache_creation_input_tokens": {"type": "null"}
            }
          }
        }
      ]
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "owner"],
      "properties": {
        "key": {"type": "string", "minLength": 1, "maxLength": 200},
        "owner": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"}
  }
}
