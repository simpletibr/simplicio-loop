      },
      "llm": {
        "status": "verified",
        "verified_on": "2026-09-29",
        "verified_version": "claude 2.1.284",
        "binary": "claude",
        "argv": [
          "claude",
          "-p",
          "--output-format",
          "json",
          "--safe-mode",
          "--system-prompt",
          "{system}",
          "--tools",
          "",
          "--no-session-persistence"
        ],
        "model_args": [
          "--model",
          "{model}"
        ],
        "prompt": "stdin",
        "system": "flag",
        "output": "json",
        "parse": "claude",
        "network": "allowed",
        "probe": [
          "api.anthropic.com:443"
        ],
        "tools": "disabled",
        "cost": "list-price",
        "overhead_tokens": 440,
        "notes": "--safe-mode drops CLAUDE.md, hooks, skills and MCP servers from the nested call (auth and model are unchanged), --tools \"\" disables every tool. Same account and model as the session."
      }
    },
