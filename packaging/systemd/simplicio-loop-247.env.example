HOME=/home/simplicio-loop
PATH=/usr/local/bin:/usr/bin:/bin
SIMPLICIO_247_STATE_DIR=/var/lib/simplicio-loop-247
SIMPLICIO_247_CONCURRENCY=1
# Executor: exec (default; CLI plans, dev-cli applies). openrouter is opt-in and needs OPENROUTER_API_KEY too.
# SIMPLICIO_EXECUTOR=exec
# SIMPLICIO_EXEC_FAMILIES=claude,codex,grok,gemini
# Login of the service user (default: $HOME/.simplicio/login.json). Needs write access for token refresh.
SIMPLICIO_247_LOGIN=/home/simplicio-loop/.simplicio/login.json

# Second executor: an LLM CLI with tools edits the worktree and gets the failures back in the same session (docs/AUTHOR_FLOW.md).
# Create /home/simplicio-loop/.cache/simplicio-loop-author (mode 0700) first: the unit lets the service write there.
# SIMPLICIO_247_EXECUTOR=author
# SIMPLICIO_247_AUTHOR_ROUNDS=3
# SIMPLICIO_247_AUTHOR_RUN_TESTS=0
