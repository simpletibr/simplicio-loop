HOME=/home/simplicio-loop
PATH=/usr/local/bin:/usr/bin:/bin
SIMPLICIO_247_STATE_DIR=/var/lib/simplicio-loop-247
SIMPLICIO_247_CONCURRENCY=1
# Login of the service user (default: $HOME/.simplicio/login.json). Needs write access for token refresh.
SIMPLICIO_247_LOGIN=/home/simplicio-loop/.simplicio/login.json
