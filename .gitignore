.simplicio-loop/*
.venv/
!.simplicio-loop/orchestrator/
.simplicio-loop/orchestrator/*
!.simplicio-loop/orchestrator/savings/
!.simplicio-loop/orchestrator/savings/snapshots.jsonl
# Legacy Simplicio state roots are quarantined; all new state belongs under .simplicio-loop/.
.orchestrator/
.simplicio-fast/
.simplicio/
*.egg-info/
__pycache__/
dist/
*.db
.serena/
.agents/
.playwright-cli/
.playwright-mcp/
output/
build/

# Rust build artifacts (any depth: root rust/, packages/*/rust/, template scaffolds)
**/rust/target/
**/target/

# Generated media (#116): video/ SOURCE (build_*.py, storyboard.master.json, lang/*, hyperframes
# HTML composition sources, render.sh, README) stays tracked; only the rendered/ephemeral OUTPUT
# is ignored — regenerate it with `bash video/render.sh` (see video/README.md).
video/out/
**/_audio_tmp/

# Packaged deliverables zip (generated artifact, not source) — see #116.
simplicio-loop_deliverables.zip

.receipts/

# Simplicio Runtime edit/validate execution receipts (local evidence, not source)

# Coverage data (pytest-cov / coverage.py) — regenerated by
# `pytest --cov=simplicio_loop --cov-report=term-missing`, not source.
.coverage
.coverage.*
htmlcov/

# Transient git worktrees created by Workflow/Agent isolation:'worktree' runs.
.claude/worktrees/
d/

# Per-package runtime artifacts written by running a package's own CLI/tests in place
# (e.g. packages/dev-cli/.simplicio-loop/, packages/dev-cli/hbp-inbox.bin) — not source, and
# distinct from the root .simplicio-loop/ rules above which carry their own tracked exceptions.
packages/*/.simplicio-loop/
hbp-inbox.bin
