[governors]
governor=deterministic_boundary|rule=no_model_no_network_no_credentials_required_for_supported_work|failure=llm_execution_disabled
governor=mapper_first|rule=fresh_bounded_snapshot_before_non_trivial_mutation|failure=survey_degraded_or_blocked
governor=scope|rule=repository_key_path_scope_snapshot_and_preconditions_required|failure=blocked
governor=preflight|rule=lock_or_causal_marker_before_every_mutation|failure=preserve_lock_on_ambiguity
governor=atomicity|rule=stage_before_write_and_rollback_on_failure|failure=ambiguous_or_diverged
governor=anchors|rule=one_non_empty_anchor_and_exactly_one_occurrence|failure=ambiguous_anchor_or_missing_anchor
governor=paths|rule=relative_portable_non_escaping_paths_only|failure=invalid_path
governor=integrated|rule=Runtime_authorizes_EffectTransaction_and_Dev_CLI_does_not_apply_effect|failure=fail_closed
governor=standalone|rule=explicit_local_lifecycle_and_no_Runtime_claims_in_receipt|failure=route_reason_recorded
governor=auto|rule=versioned_handshake_and_policy_choose_effective_mode|failure=CONTEXT_REQUIRED_or_AUTO_DEGRADED
governor=retry|rule=retry_only_declared_transient_classes_and_never_retry_unknown_effect|failure=preserve_lock_and_reconcile
governor=fast|rule=compatible_fresh_Mapper_snapshot_required_and_stale_index_falls_back|failure=degraded
governor=loop|rule=orchestration_only_with_one_task_per_slot_by_default|failure=blocked_slot_stays_blocked
governor=runtime|rule=gates_checkpoints_receipts_and_reconciliation_are_Runtime_owned|failure=unknown_effect
governor=output|rule=stdout_machine_payload_stderr_diagnostics|failure=transport_corruption
limit=task_attempts|default=5|override=SIMPLICIO_MAX_ATTEMPTS|invalid_value=default
limit=intake_url|bytes=2097152|timeout_seconds=10|source=simplicio/commands/intake.py
limit=test_run|timeout_seconds=120|source=task_test_help
limit=runtime_payload|bytes=1048576|failure=reject_before_network
limit=runtime_circuit_breaker|consecutive_failures=3|open_seconds=30
limit=fast_doctor|ready_exit=0|absent_exit=2|incompatible_exit=3|degraded_exit=4

[tests]
runner=pytest|testpaths=tests/python;tests/contracts|source=pyproject.toml
focal=tests/python/test_llm_orientation.py|command=pytest tests/python/test_llm_orientation.py -q|purpose=pack_parse_structure_paths_commands_secrets
contracts=tests/python/test_task_spec.py;tests/python/test_execution_contract.py;tests/python/test_task_json_contract.py|purpose=TaskSpec_and_task_result_regression
boundaries=tests/python/test_issue_691_edit_scaffold.py;tests/python/test_evidence_ledger.py;tests/python/test_fast_contracts.py;tests/python/test_mapper_handoff_integration.py|purpose=edit_evidence_fast_mapper_regression
native_help=python3 -m simplicio.cli --help;python3 -m simplicio.cli task --help;python3 -m simplicio.cli intake --help|purpose=source_checkout_help_probe
quality=ruff check .;ruff format --check .;mypy simplicio|purpose=repository_quality_gate
coverage=pytest --cov=simplicio --cov-report=json:coverage.json;python3 scripts/coverage_gate.py --report coverage.json|threshold=85_global_and_90_critical

[workflow]
step=bootstrap|read=AGENTS.md;CLAUDE.md;active_operating_docs;relevant_skills|stop_if=missing_or_unreadable_contract
step=survey|mcp=simplicio_map|order=before_memory_and_skills|bounded=true|evidence=ids
step=recall|mcp=simplicio_memory|order=after_map|match=or|purpose=prior_decisions
step=skills|mcp=simplicio_skills|order=after_memory|purpose=selected_skill_capsules
step=route|skill=simplicio-prism|purpose=choose_smallest_capability_set
step=gate|mcp=simplicio_gate|purpose=classify_mutation_before_source_change
step=checkpoint|mcp=simplicio_checkpoint|purpose=rollback_point_before_risky_change
step=prepare|owner=agent|inputs=revision_scope_completion_oracle|output=bounded_plan
step=execute|owner=dev_cli|inputs=Mapper_snapshot_intent_scope_constraints|output=diff_and_operation_id
step=validate|owner=dev_cli_or_pytest|inputs=diff_tests_exit_status_evidence|output=proven_or_failed
step=verify|owner=independent_checker|inputs=real_feature_edge_case_error_path|output=adversarial_record
step=handoff|owner=Loop_or_Runtime|inputs=durable_receipt_evidence_verdict|rule=partial_blocked_ambiguous_never_success

[handoff]
mapper=observation_and_context|owns=repository_id_generation_source_tree_id_source_hashes|next=provide_fresh_snapshot_and_selected_context
fast=optional_acceleration|owns=bounded_indexed_retrieval_only|next=use_only_with_compatible_snapshot_else_fallback_to_mapper
dev_cli=execution_edit_validate_diagnostics|owns=plan_edit_receipt_scaffold_receipt|next=return_operation_id_diff_tests_evidence_verdict
loop=runtime_agnostic_orchestration|owns=stages_slots_retry_review_convergence|next=one_task_per_slot_and_preserve_blocked_or_ambiguous
runtime=governance_and_effects|owns=gate_checkpoint_authorization_effect_application_effect_receipt_reconcile|next=integrated_mode_only_with_validated_inputs
prism=routing_only|owns=classification_order_cost_evidence_plan|next=never_mutate_or_fabricate_capability
handoff_order=Mapper_to_Fast_optional_to_Dev_CLI_to_Loop_or_Runtime|reanchor=revision_scope_snapshot_and_hashes
task_result_fields=operation_id_snapshot_id_pre_effect_effect_post_effect_diff_tests_evidence_file_verdict_retry_history
blocked_routes=mapper_artifacts;mapper_inspection;context_pack;task_target;provider_or_execution_mode|action=follow_next_surface_and_preserve_receipt

[forbidden]
rule=do_not_add_provider_credentials|action=fail_closed_and_redact
rule=do_not_invent_commands|action=rerun_specific_help_and_mark_unknown_alias
rule=do_not_bypass_mapper_for_non_trivial_mutation|action=survey_first
