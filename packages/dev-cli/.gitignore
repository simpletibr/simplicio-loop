__pycache__/
*.egg-info/
*.npz
.venv/
build/
dist/
dist_new/
.env

# JS / Playwright
node_modules/
playwright-report/
test-results/
.runtime-logs/

# Rust build artifacts
rust/*/target/

# Simplicio ecosystem state has one root; legacy roots are quarantined.
.simplicio-loop/orchestrator/
.orchestrator/

# Per-bench-run scratchpad: every model × case raw output. Regenerated on
# every bench run; we keep results JSON/MD/PDF artifacts under bench/ but
# not the per-case scratchpads.
.simplicio-loop/bench_runs/
.simplicio-loop/cache/
# local GGUF model blobs (kept out of git; see bench/RESULTS_LOCAL_GGUF.md)
models/*.gguf
models/.cache/
# Local GGUF weights (Path 4 in-process llama backend)
*.gguf
/models/

# Stray backup/temp files that shouldn't be committed (issue #104): a
# README.backup-2026-05-27.md sat at repo root before being noticed. Catch
# this pattern before it recurs.
*.backup
*.backup-*
*.bak
*~

# Local Gradle build cache (issue #711): a local `.gradle/` build-cache
# directory was accidentally committed under four scratch stack templates
# (java-spring, kotlin-android, kotlin-ktor, kotlin-spring), shipping
# binary Java serialization/lock/checksum files that broke
# `render_tree`'s UTF-8 template read. Not part of any stack template —
# generated fresh by Gradle on first build. Catch this pattern before it
# recurs.
.gradle/
