{
  "schema": "simplicio.plugin.context-packet/v1",
  "major": 1,
  "minor": 0,
  "authority": "derived_read_only",
  "writes": false,
  "instructions": false,
  "required": [
    "schema",
    "abi",
    "task_id",
    "session_id",
    "handle",
    "generation",
    "base_generation",
    "source_ref",
    "source_hashes",
    "generation_digest",
    "spans",
    "payload",
    "provenance",
    "cache_status",
    "truncated",
    "truncation_reasons",
    "completeness",
    "fidelity",
    "budget",
    "encoded_bytes",
    "packet_hash"
  ],
  "handle_schema": "simplicio.plugin.context-handle/v1",
  "request_schema": "simplicio.plugin.context-request/v1",
  "hbp_schema": "simplicio.plugin.context-packet-hbp/v1",
  "fidelities": ["metadata", "summary", "exact"],
  "cache_status": ["cold", "warm"],
  "limits": {
    "max_encoded_bytes": 8388608,
    "max_items": 100000,
    "max_text": 4096
  },
  "compatibility": {
    "unknown_major": "reject",
    "unknown_optional_minor": "ignore",
    "digest_mismatch": "reject",
    "stale_generation": "reject",
    "private_layout_fields": "reject"
  },
  "reason_codes": [
    "budget_invalid",
    "cancellation_requested",
    "generation_missing",
    "generation_stale",
    "generation_tampered",
    "handle_missing",
    "handle_stale",
    "handle_tampered",
    "overlay_escape",
    "packet_corrupt",
    "packet_schema_invalid",
    "path_escape",
    "payload_not_json",
    "plugin_abi_unsupported",
    "plugin_schema_unsupported",
    "private_layout_field",
    "source_hash_mismatch",
    "slice_missing"
  ]
}
