{
  "schema": "simplicio.fast.projection-envelope/v1",
  "envelope": {
    "schema": "simplicio.fast.projection/v1",
    "major": 1,
    "minor": 0,
    "required": [
      "schema",
      "projection_type",
      "producer",
      "producer_schema",
      "generation",
      "stable_handle",
      "payload",
      "payload_sha256",
      "schema_version",
      "projection_type_version",
      "producer_version",
      "repository_scope",
      "tenant_scope",
      "domain_scope",
      "source_generation",
      "projection_generation",
      "stable_handles",
      "capabilities_required",
      "completeness",
      "fidelity"
    ]
  },
  "type_manifest": {
    "schema": "simplicio.fast.projection-type-manifest/v1",
    "types": ["code", "knowledge", "operations"],
    "versions": {"code": "1.0", "knowledge": "1.0", "operations": "1.0"}
  },
  "capabilities": {
    "schema": "simplicio.fast.projection-capabilities/v1",
    "required": ["projection.decode.v1", "projection.digest.sha256"]
  },
  "limits": {
    "max_encoded_bytes": 8388608,
    "max_depth": 32,
    "max_items": 100000,
    "max_text": 4096
  },
  "reason_codes": [
    "payload_digest_mismatch",
    "payload_digest_missing",
    "projection_capability_missing",
    "projection_depth_limit",
    "projection_exposes_offset",
    "projection_item_limit",
    "projection_schema_unsupported",
    "projection_scope_mismatch",
    "projection_size_limit",
    "projection_type_unsupported"
  ],
  "compatibility": {
    "unknown_major": "reject",
    "unknown_optional_minor": "preserve_or_reject_by_manifest",
    "missing_required_capability": "reject",
    "digest_mismatch": "reject",
    "scope_mismatch": "reject"
  }
}
