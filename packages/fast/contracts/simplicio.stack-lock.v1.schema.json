{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wesleysimplicio/simplicio-fast/contracts/simplicio.stack-lock.v1.schema.json",
  "title": "Simplicio stack lock v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "profile", "members", "contracts", "required_contracts", "routes"],
  "properties": {
    "schema": {"const": "simplicio.stack-lock/v1"},
    "profile": {"enum": ["loop-standalone", "runtime-backed"]},
    "members": {
      "type": "array",
      "minItems": 4,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["repository", "commit", "version"],
        "properties": {
          "repository": {"type": "string", "pattern": "^wesleysimplicio/simplicio-[a-z0-9.-]+$"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "version": {"type": "string", "minLength": 1},
          "artifact_digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
          "optional": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "contracts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["schema", "owner", "producer", "consumers", "digest"],
        "properties": {
          "schema": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "producer": {"type": "string", "minLength": 1},
          "consumers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "required_contracts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "routes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["source", "target", "kind", "authority"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  }
}
