{
  "$id": "https://simplicio.dev/schemas/ecosystem/v1/loop-execution.schema.json",
  "title": "simplicio.loop-execution/v1",
  "description": "VENDORED COPY (issue #164). This is a local, hand-maintained copy of the run-journal / task-anchor execution record produced by simplicio-loop's autonomous loop (see simplicio-loop CLAUDE.md: scripts/loop_journal.py, scripts/task_anchor.py). It is NOT imported live from the simplicio-loop repository -- true cross-repo schema import is not practical from this sandbox. simplicio-loop is the source of truth; when its run-journal/task-anchor payload shape changes, update this file to match and bump the version directory (v1 -> v2) if the change is breaking. See ../README.md for the sync convention.",
  "type": "object",
  "required": ["schema", "task_id", "goal", "status", "attempts", "promise"],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["simplicio.loop-execution/v1"]
    },
    "task_id": { "type": "string" },
    "goal": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["running", "blocked", "done", "capped"]
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "action", "result"],
        "properties": {
          "index": { "type": "integer" },
          "action": { "type": "string" },
          "result": { "type": "string" },
          "stalled": { "type": "boolean" }
        }
      }
    },
    "promise": {
      "type": ["object", "null"],
      "properties": {
        "text": { "type": "string" },
        "evidence_gated": { "type": "boolean" },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "verified"],
            "properties": {
              "id": { "type": "string" },
              "verified": { "type": "boolean" },
              "evidence": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "traceability": {
      "type": "object",
      "required": ["schema", "fingerprint", "complete", "static_inference"],
      "properties": {
        "schema": { "type": "string", "enum": ["simplicio.task-traceability/v1"] },
        "fingerprint": { "type": "string" },
        "complete": { "type": "boolean" },
        "static_inference": { "type": "boolean" }
      }
    }
  }
}
