{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simplicio.mapper-fast-handoff/v1",
  "type": "object",
  "required": ["schema", "generation", "canonical_map", "capabilities", "artifacts", "delta"],
  "properties": {
    "schema": {"const": "simplicio.mapper-fast-handoff/v1"},
    "generation": {"type": "string", "minLength": 1},
    "repository_id": {"type": ["string", "null"]},
    "revision": {"type": "string"},
    "canonical_map": {
      "type": "object",
      "required": ["schema", "version", "id", "default_branch", "repository_id", "generation", "digest"],
      "properties": {
        "schema": {"const": "simplicio.context-graph-contract/v1"},
        "version": {"const": 1},
        "id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "default_branch": {"type": "string", "minLength": 1},
        "repository_id": {"type": ["string", "null"]},
        "generation": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "capabilities": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "delta": {
      "type": "object",
      "required": ["base_commit", "changed_paths", "node_ids", "edge_ids", "affected"]
    }
  },
  "additionalProperties": false
}
