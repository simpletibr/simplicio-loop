{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simplicio.ecc-guidance-ref/v1",
  "title": "Simplicio ECC advisory provenance reference (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "stage",
    "role_id",
    "source",
    "provenance",
    "manifest_hash",
    "pack_hash",
    "authority",
    "execution_policy",
    "components"
  ],
  "properties": {
    "schema": {"const": "simplicio.ecc-guidance-ref/v1"},
    "status": {"const": "READY"},
    "stage": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "role_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "source": {"$ref": "#/$defs/source"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "manifest_hash": {"$ref": "#/$defs/hash"},
    "pack_hash": {"$ref": "#/$defs/hash"},
    "authority": {"const": "simplicio-mapper"},
    "execution_policy": {"const": "advisory-only"},
    "components": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/component"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": {"const": "https://github.com/affaan-m/ECC"},
        "ref": {"const": "0c1d7be9a750627fb2a6534c78a998cc46d03f9c"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expected_ref", "observed_ref"],
      "properties": {
        "status": {"const": "VERIFIED"},
        "expected_ref": {"const": "0c1d7be9a750627fb2a6534c78a998cc46d03f9c"},
        "observed_ref": {"const": "0c1d7be9a750627fb2a6534c78a998cc46d03f9c"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "path", "sha256", "content_sha256", "truncated"],
      "properties": {
        "kind": {"enum": ["skill", "agent"]},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "path": {"type": "string", "pattern": "^(skills/[^./][^/]*/SKILL[.]md|agents/[^./][^/]*[.]md)$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "content_sha256": {"$ref": "#/$defs/hash"},
        "truncated": {"type": "boolean"}
      }
    }
  }
}
