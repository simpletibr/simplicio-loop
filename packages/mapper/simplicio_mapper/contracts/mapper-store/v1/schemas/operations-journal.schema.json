{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.simplicio.dev/mapper-store/v1/operations-journal.schema.json",
  "title": "simplicio.mapper-store.operations-journal/v1",
  "type": "object",
  "required": ["schema", "status", "run_id", "seq", "event_id", "event_hash"],
  "properties": {
    "schema": { "enum": ["simplicio.mapper-store.operations-api/v1"] },
    "status": { "enum": ["appended"] },
    "run_id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
