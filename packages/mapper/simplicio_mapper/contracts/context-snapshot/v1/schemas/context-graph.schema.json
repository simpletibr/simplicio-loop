{
  "$id": "simplicio.context-graph/v1",
  "title": "simplicio-mapper ContextGraph (v1)",
  "description": "Multi-scale graph embedded in a ContextSnapshot. Source handles are repo-relative and reversible.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "nodes", "edges", "counts", "scale_semantics", "drilldown"],
  "properties": {
    "schema": {"type": "string", "enum": ["simplicio.context-graph/v1"]},
    "version": {"type": "integer", "enum": [1]},
    "nodes": {"type": "array", "maxItems": 100000, "items": {"type": "object", "additionalProperties": false, "required": ["id", "scale", "content_hash", "source"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 4096}, "scale": {"type": "string", "enum": ["micro", "meso", "macro"]}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source": {"$ref": "#/$defs/sourceHandle"}}}},
    "edges": {"type": "array", "maxItems": 200000, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "source", "target", "content_hash", "source_handle"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 4096}, "kind": {"type": "string", "minLength": 1, "maxLength": 256}, "source": {"type": "string", "minLength": 1, "maxLength": 4096}, "target": {"type": "string", "minLength": 1, "maxLength": 4096}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "relation_id": {"type": "string", "minLength": 1, "maxLength": 128}, "evidence_class": {"type": "string", "enum": ["semantic_resolved", "import_resolved", "lexical_unique", "lexical_ambiguous", "heuristic", "runtime_observed"]}, "resolution_status": {"type": "string", "enum": ["resolved", "inferred", "ambiguous", "unknown"]}, "provenance": {"type": "object"}, "target_candidates": {"type": "array", "items": {"type": "string"}}, "source_handle": {"$ref": "#/$defs/sourceHandle"}}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges"], "properties": {"nodes": {"type": "integer", "minimum": 0}, "edges": {"type": "integer", "minimum": 0}, "micro": {"type": "integer", "minimum": 0}, "meso": {"type": "integer", "minimum": 0}, "macro": {"type": "integer", "minimum": 0}}},
    "scale_semantics": {"type": "object", "maxProperties": 3},
    "drilldown": {"type": "object", "maxProperties": 16},
    "relation_coverage": {"type": "object", "maxProperties": 32}
  },
  "$defs": {"sourceHandle": {"type": "object", "additionalProperties": false, "required": ["file"], "properties": {"file": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "line": {"type": "integer", "minimum": 1}, "span": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}}}}
}
