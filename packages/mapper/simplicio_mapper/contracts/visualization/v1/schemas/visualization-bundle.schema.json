{
  "$id": "simplicio.visualization-bundle/v1",
  "title": "Renderer-neutral visualization bundle",
  "type": "object",
  "required": ["schema", "version", "mapper_version", "schema_version", "capabilities", "generated_at", "provenance", "project", "nodes", "edges", "flows", "diagnostics", "language_diagnostics"],
  "properties": {
    "schema": { "type": "string", "enum": ["simplicio.visualization-bundle/v1"] },
    "version": { "type": "integer" },
    "mapper_version": { "type": "string" },
    "schema_version": { "type": "string", "enum": ["v1"] },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "project": { "type": "object", "required": ["id", "name", "root"] },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "clustering": { "type": "object", "required": ["schema", "version", "mapper_version", "schema_version", "generated_at", "project", "config", "clusters", "layout_hints", "provenance"] },
    "layout_hints": { "type": "array" },
    "flows": { "type": "array" },
    "diagnostics": { "type": "array" },
    "language_diagnostics": { "type": "array", "items": { "type": "object", "required": ["path", "language", "line_count", "parser_used", "parser_version", "confidence", "errors", "skipped", "unsupported_constructs"] } }
  },
  "$defs": {
    "provenance": { "type": "object", "required": ["remote_url", "remotes", "branch", "commit_sha", "dirty", "scan_root", "clone_type", "submodules", "monorepo_roots"] },
    "node": { "type": "object", "required": ["id", "kind", "name", "canonical", "metrics"] },
    "edge": { "type": "object", "required": ["type", "source", "target", "direction", "confidence", "provenance"] }
  }
}
