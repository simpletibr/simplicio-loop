[meta]
format=toon-like-line-oriented
kind=llm_orientation_cache
purpose=understand simplicio-fast before a scoped task
language=en
not_a_contract=true
source_policy=observed_facts_only;authoritative_sources_and_help_win
cache_role=orientation_only;never replaces source_docs_or_contracts
