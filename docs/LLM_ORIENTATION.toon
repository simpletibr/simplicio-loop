[commands]
entrypoint=simplicio-fast;help=simplicio-fast --help;capture=command_not_found
module_help=PYTHONPATH=src python3 -m simplicio_fast.cli --help;status=exit_0
version_help=PYTHONPATH=src python3 -m simplicio_fast.cli --version;observed=simplicio-fast 2.0.32
cross_repo_help=PYTHONPATH=src python3 -m simplicio_fast.cross_repo_cli --help;status=exit_0
top_level=build,refresh,ingest,query,search,context,navigate,impact,stats,query-plan,segments,understand,plan,delivery,apply,changeset,doctor,rollout,serve,base,overlay,delta,handoff,merge,semantic-score,capabilities,parser-payload,pin,release,gc,watch
command=build|help=simplicio-fast build --help|role=publish_snapshot
command=refresh|help=simplicio-fast refresh --help|role=incremental_refresh
command=ingest|help=simplicio-fast ingest --help|role=publish_snapshot
command=query|help=simplicio-fast query --help|role=bounded_symbol_lookup
command=search|help=simplicio-fast search --help|role=direct_index_lookup
command=context|help=simplicio-fast context --help|role=hash_verified_spans
command=navigate|help=simplicio-fast navigate --help|role=one_bounded_relation_hop
command=impact|help=simplicio-fast impact --help|role=typed_impact_relations
command=stats|help=simplicio-fast stats --help|role=snapshot_generation_stats
command=query-plan|help=simplicio-fast query-plan --help|role=bounded_index_budget_plan
command=segments|help=simplicio-fast segments --help|role=immutable_section_storage
command=understand|help=simplicio-fast understand --help|role=bounded_task_context
command=plan|help=simplicio-fast plan --help|role=compile_plandag
command=delivery|help=simplicio-fast delivery --help|role=guarded_delivery_receipt
command=apply|help=simplicio-fast apply --help|role=dry_run_or_guarded_apply
command=changeset|help=simplicio-fast changeset --help|role=binary_changeset_lifecycle
command=doctor|help=simplicio-fast doctor --help|role=readiness_fail_closed
command=rollout|help=simplicio-fast rollout --help|role=shadow_canary_rollback_receipt
command=serve|help=simplicio-fast serve --help|role=crud_proof_api
command=base|help=simplicio-fast base --help|role=canonical_generation
command=overlay|help=simplicio-fast overlay --help|role=isolated_worktree_view
command=delta|help=simplicio-fast delta --help|role=changed_path_delta
command=handoff|help=simplicio-fast handoff --help|role=base_delta_handoff
command=merge|help=simplicio-fast merge --help|role=composed_view_query
command=semantic-score|help=simplicio-fast semantic-score --help|role=bounded_candidate_ranking
command=capabilities|help=simplicio-fast capabilities --help|role=capability_negotiation
command=parser-payload|help=simplicio-fast parser-payload --help|role=mapper_handoff_adapter
command=pin|help=simplicio-fast pin --help|role=generation_lease
command=release|help=simplicio-fast release --help|role=release_generation_lease
command=gc|help=simplicio-fast gc --help|role=list_or_remove_unleased_generations
command=watch|help=simplicio-fast watch --help|role=one_overlay_refresh
nested=changeset:prepare,validate,seal,inspect,export-json,materialize,reconcile,recover|help=simplicio-fast changeset <action> --help
nested=cross-repo:validate|help=simplicio-fast-cross-repo validate --help
status=absent;use=doctor,stats
plandag=absent;use=plan
[contracts]
component=mapper|owns=canonical ContextGraph;stable IDs;source facts;fast-handoff
component=fast|owns=bounded context;binary_mmap_snapshot;PlanDAG;generations;overlays;hash guards
component=dev-cli|owns=mechanical source mutation;edit validation
component=runtime|owns=Full effect policy;gates;native execution;durable receipts
component=loop|owns=slots;attempt progression;retries;watchers;convergence
component=agent-llm|owns=decision;provider choice;patch strategy;not Fast authority
format=simplicio.mapper-fast-handoff/v1|Mapper input;validated handoff plus handoff receipt
format=simplicio.fast.plandag/v2|plan output;orient_modify_validate_refresh nodes
format=simplicio.fast.understanding/v2|bounded semantic understanding output
format=simplicio.fast.changeset/v2|generation;paths;expected hashes;idempotency;Dev CLI boundary
format=simplicio.fast.context-request/v2|delivery context request
format=simplicio.fast.handoff/v1|base/delta/worktree/config/parity handoff
format=simplicio.fast.delivery-engine/v1|delivery preparation;cache;provenance;stages
format=simplicio.fast-generation-receipt/v1|repo;commit;snapshot digest;generation;source hashes;backend;idempotency
format=simplicio.fast.receipt/v1|workspace generation and overlay evidence
format=simplicio.fast.query-plan/v1|index selection;candidate count;byte and token budgets;reason
format=simplicio.fast.rollout-receipt/v1|shadow;canary;integrated;fallback;rollback state
format=simplicio.fast.cross-repo-receipt/v1|pinned stack-lock compatibility evidence
format=simplicio.fast.error/v1|typed command failure;error and recovery reason
[receipts]
owner=fast|provenance;generation;delivery;rollout;workspace receipts
owner=runtime|Full effect;policy;gate;validation receipts;Fast does not synthesize them
formats=simplicio.fast-generation-receipt/v1;simplicio.fast.delivery-engine/v1;simplicio.fast.receipt/v1;simplicio.fast.rollout-receipt/v1;simplicio.fast.cross-repo-receipt/v1
rule=record repository;revision;binary version or digest;Mapper generation;artifact digest;source hashes;status;reason;tests;durable evidence
classification=MEASURED only with command and metrics;otherwise UNVERIFIED or BLOCKED;never promote estimates
idempotency=delivery and generation receipts bind replay keys or hashes where their producer requires them
[governors]
limits=context max-results;max-lines;max-bytes;max-tokens;enforce before context delivery
source_file_limit=--max-file-bytes default 83886080 bytes;SourceFileTooLarge before parse
freshness=pin generation;verify source_sha256 per span;reject stale;refresh before retry
snapshots=read_only_mmap;immutable publication;atomic replace;source files stay authoritative
engine=auto|rust|python|off;rust requires healthy conformance;rust failure is fail_closed
effects=apply and delivery dry_run by default;Full writes require Runtime transaction;Loop standalone guarded write is explicit
[tests]
focused=tests/test_llm_orientation.py;line parser;required fields;source and skill digests;help surface;secret rejection
native=PYTHONPATH=src python3 -m unittest discover -s tests -p test_llm_orientation.py -v
project_suite=PYTHONPATH=src python -m unittest discover -s tests -v
compile=python -m compileall -q src tests benchmarks
benchmark=python benchmarks/run.py
contract_smoke=simplicio contracts smoke --json
validation=simplicio validate "<task>" --repo . --json
[workflow]
sequence=pin repo;revision;scope;completion oracle -> read docs and selected skills -> Mapper handoff or bounded survey -> build_or_ingest -> context_or_understand -> plan -> changeset validate -> apply_or_delivery dry_run -> Dev CLI -> tests -> refresh -> handoff_or_rollout_receipt
preparation=run exact --help at the command level;check doctor;keep source hashes and generation pinned
ingest=integrated consumes validated simplicio-mapper fast-handoff;bootstrap is explicit development_only fallback
context=context_or_understand returns bounded hash_verified spans;never dump whole repository
plan=plan emits simplicio.fast.plandag/v2;LLM decides from selected context
change=changeset carries expected source hashes and idempotency;Dev CLI owns source edit;Runtime authorizes Full effects
refresh=after validated source change refresh derived semantic inputs and recheck freshness
[handoff]
loop_standalone=validate simplicio.stack-lock/v1 with cross_repo profile;Loop owns slots,retries,convergence;Fast supplies derived read_only context;Runtime absent
runtime_backed=Mapper -> Fast -> Dev CLI;Loop coordinates attempts;Runtime owns Full effect and policy;require coordinator transaction for Full write
mapper=run simplicio-mapper snapshot build and fast-handoff;pass the validated handoff to Fast;reject stale or incomplete handoff
dev_cli=pass bounded PlanDAG or changeset plus evidence to Dev CLI;collect diff,tests,post_effect and durable receipt
evidence=attach generation;source hashes;artifact digests;tests;status;reason;consumer receipts;missing consumer proof is UNVERIFIED
[forbidden]
authority=source_truth=authoritative;Fast_not_policy_or_mutation_owner
access=raw_snapshot_offsets=forbidden;consumers_use_handles_and_versioned_outputs
secret_material=no_provider_credentials_or_tokens
state=missing_stale_corrupt_incompatible=blocked;empty_context_is_not_success
effects=Full_write_without_Runtime_authorization=blocked;partial_or_blocked_is_not_success
task_banned_options=serial,max-workers,retry-budget,fan-out
[known_limits]
binary=simplicio-fast entrypoint was unavailable here;Python module help passed;Rust artifact readiness not claimed
integration=Mapper;Dev CLI;Loop;Runtime cross_repo E2E receipts were not produced by this Fast-only task
availability=Fast index was deferred until Mapper;memory query had no project-specific result;external providers were not used
metrics=No benchmark or performance claim is made;measurements require matching workload;hardware;cache and repetitions
[freshness]
captured_at=2026-09-13;timezone=America/Sao_Paulo
index=deferred_until_mapper;reason=fast_snapshot_missing_or_invalid
recheck=rerun exact help;recompute source digests;run doctor;refresh stale snapshots;obtain consumer receipts before claiming integration
