section contracts
fact contract.1.id=simplicio.loop-execution/v1
fact contract.1.path=contracts/loop-execution/v1/schema.json
fact contract.1.owner=simplicio-loop producer; simplicio-runtime consumer and independent validator
fact contract.2.id=simplicio.loop-execution/v1 receipt
fact contract.2.path=contracts/loop-execution/v1/receipt.schema.json
fact contract.2.owner=simplicio-loop publishes; Runtime consumes after reconciliation gates
fact contract.3.path=contracts/loop-execution/v1/SCHEMA.md
fact contract.3.owner=contract maintainers; narrative only, schema.json remains field authority
fact contract.modes=converge and drain; fast-path is reduced rigor layered over converge
fact contract.converge=promise exact match + same-turn evidence + watcher recheck + no open anchor criterion
fact contract.drain=source empty for K consecutive dry rounds and working set idle; drained is idle, not termination
fact contract.state=only existing scratchpad, journal, anchor, watcher, stop, handoff, and reference drain state
fact contract.prohibition=do not invent a second promise/evidence/anchor/watcher gate
section receipts
fact schema=simplicio.loop-execution/v1
fact source=contracts/loop-execution/v1/receipt.schema.json
fact chain=simplicio-loop -> simplicio-mapper -> simplicio-dev-cli -> simplicio-runtime
fact completion=watcher+delivery+quality-matrix+completion-oracle
fact artifact_bundle=run-owned runtime-loop-execution bundle; copied state files and final Mapper/Dev CLI receipts
fact portability=artifact copies carry digest and bundle-relative path; root envelope is atomically replaced
fact fast_observation=Fast is additive from stack lock; it does not change the v1 chain
fact unknown_effect=preserve-lock-and-reconcile
fact fallback=fail-closed; no fabricated receipt
fact semantics=receipts are evidence, not self-attestation; watcher challenge and status must be current and MEASURED
section governors
fact truth=MEASURED|receipt-backed; otherwise UNVERIFIED|
fact writes=serialized; physical capacity governed
fact authority=Runtime decides loop activation; Prism routes; Mapper surveys; Fast accelerates; Dev CLI operates
fact runtime=optional for ordinary standalone Loop work; required only when policy/task requires governed Runtime evidence
fact retry=bounded by the selected contract; same fingerprint means change strategy or escalate
fact parallelism=1-3 tasks direct; more than 3 uses Prism; physical governor may defer admission
fact artifacts=central default-branch binary and Mapper/Fast artifacts are read-only to workers
fact missing_artifacts=fail-closed; route central rebuild; never repair locally or fabricate context
fact prohibitions=no provider, API key, token, secret, or unobserved command
section tests
fact red=write focused tests first; run pytest and require RED
fact green=implement pack; run focused pytest and require GREEN
fact focused=python3 -m pytest -q tests/test_llm_orientation_pack.py
fact contract_gate=python3 scripts/check_loop_contract.py
fact public_gate=python3 scripts/check.py
fact static=python3 -m py_compile tests/test_llm_orientation_pack.py; parse pack with focused test
fact review=git diff --check; secret scan; search for v2
section workflow
fact sequence=map -> memory -> skills -> gate/checkpoint -> TDD -> validate -> evidence
fact intake=pin repo, revision, scope, completion oracle; recheck source and command --help
fact tdd=red focused tests; add docs pack; green focused tests; then public/documented validation
fact validation=run real gates and retain exit status/output; no claimed pass without evidence
fact freshness=compare recorded baseline, paths, digests, installed versions, and current --help
fact close=review diff; secret scan; run tests; commit; push branch; open PR only after green evidence
section handoff
fact mapper=read-only survey -> fresh bounded snapshot and handoff; never source authority
fact fast=use only with compatible fresh Mapper artifact; missing/stale/corrupt -> explicit unavailable and Mapper path
fact dev_cli=bounded deterministic edit/verify owner; do not hand-edit where operator path exists
fact runtime=optional standalone; when active owns gate, checkpoint, receipt, reconciliation, and loop activation
fact coordinator=LLM decides scoped plan; operators execute; provider sessions never own mutation authority
section forbidden
rule execution_contract=no new execution schema, parallel envelope, universal schema, or receipt alias
rule contract_version=do not add a next execution-contract version; reuse contracts/loop-execution/v1
rule secrets=no provider use, API credentials, tokens, or real secret values; reject secret-looking assignments
rule commands=do not copy commands or flags that were not observed from a real help/run result
rule parallelism=do not add prohibited scheduler controls or bypass physical governors
rule evidence=never fabricate tests, metrics, savings, receipts, context, provider output, or completion
rule mutation=respect gate, checkpoint, ownership, lease, central artifacts, and Dev CLI/Runtime boundaries
section known_limits
unavailable fast_cli=UNAVAILABLE|simplicio-fast command not found
unavailable fast_snapshot=UNAVAILABLE|snapshot missing or invalid; mapper-deferred
unavailable mcp_architecture_map=BLOCKED|MAP_OPERATION_DECLARED_ONLY
unavailable runtime_provider=UNAVAILABLE|local LLM execution disabled by runtime policy
fact mcp_map_overview=MEASURED|runtime overview available; architecture operation remains blocked
fact runtime_embedded_fast=available through simplicio 3.8.47 runtime map; direct Fast CLI absence still matters
fact installed_versions=simplicio-loop 3.43.12; Mapper 0.26.31; Dev CLI 0.18.13; Runtime 3.8.47
inference train_drift=AGENTS/CLAUDE document an older train in places; current installed/package identity must be rechecked
fact scope=pack does not execute Loop, activate Runtime, rebuild artifacts, or replace a contract
